{
  "name": "echo-app",
  "private": true,
  "version": "0.5.0",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "turbo run dev --filter=apps/web",
    "build": "vite build",
    "build:web": "turbo run build --filter=apps/web",
    "check-types": "tsc --noEmit",
    "pipeline": "bun run check-types && bun run build",
    "format": "bunx ultracite fix",
    "lint": "bunx ultracite check",
    "ci:local": "bun run pipeline && cd src-tauri && cargo check",
    "ci:bundle": "bun run ci:local && bun run tauri:build",
    "release:dryrun": "gh workflow run release-dryrun.yml --ref \"$(git rev-parse --abbrev-ref HEAD)\" && gh run watch",
    "release:start": "gh workflow run release.yml --ref main && gh run watch",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "test:macos-overlay-focus": "swift scripts/macos-overlay-focus-smoke.swift",
    "test:rust": "cd src-tauri && cargo test",
    "prepare:polish-runtime": "bun run scripts/prepare-polish-runtime.ts",
    "preview": "vite preview",
    "tauri:dev": "bun run prepare:polish-runtime && tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "bun run prepare:polish-runtime && tauri build",
    "prepare": "husky",
    "version": "bun ./scripts/bump-version.ts",
    "clean": "rm -rf .turbo .cargo node_modules bun.lock dist src-tauri/target apps/web/node_modules && bun install"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ariakit/react": "^0.4.26",
    "@base-ui/react": "^1.6.0",
    "@floating-ui/react": "^0.27.19",
    "@platejs/ai": "^53.0.4",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/callout": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/combobox": "^53.0.0",
    "@platejs/date": "^53.0.0",
    "@platejs/excalidraw": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/layout": "^53.0.0",
    "@platejs/link": "^53.0.3",
    "@platejs/list-classic": "^53.0.0",
    "@platejs/markdown": "^53.0.4",
    "@platejs/math": "^53.0.0",
    "@platejs/media": "^53.0.1",
    "@platejs/mention": "^53.0.0",
    "@platejs/slash-command": "^53.0.0",
    "@platejs/suggestion": "^53.0.3",
    "@platejs/table": "^53.0.0",
    "@platejs/toc": "^53.0.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-fs": "~2.5.1",
    "@tauri-apps/plugin-global-shortcut": "~2.3.1",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-opener": "~2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-store": "~2.4.3",
    "ai": "^6.0.228",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "platejs": "^53.0.5",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hotkeys-hook": "^5.3.2",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.4.4",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tauri-apps/cli": "~2.10.1",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "react-grab": "^0.1.48",
    "react-scan": "^0.5.7",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "ultracite": "7.2.4",
    "vite": "^8.1.4"
  }
}
